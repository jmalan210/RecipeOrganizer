[{"title":"Chocolate Chip Cookies","servings":36,"description":"Soft, chewy, classic, and delicious!","ingredients":[{"name":"Butter, softened","quantity":2.0,"unit":"cups"},{"name":"White sugar","quantity":0.75,"unit":"cup"},{"name":"Brown sugar","quantity":0.75,"unit":"cup"},{"name":"Eggs","quantity":2.0},{"name":"Maple extract","quantity":1.0,"unit":"tsp"},{"name":"Baking Soda","quantity":1.0,"unit":"tsp"},{"name":"Salt","quantity":0.5,"unit":"tsp"},{"name":"Flour","quantity":2.25,"unit":"cups"},{"name":"Semi-sweet chocolate chips","quantity":12.0,"unit":"oz"}],"instructions":[{"step":"Preheat oven to 375 F."},{"step":"In a stand mixer, cream butter, sugars, eggs, and extract until light and fluffy."},{"step":"Add soda, salt, and flour and mix until just combined."},{"step":"Stir in chocolate chips."},{"step":"Place 2-Tbsp scoops on cookie sheet and bake for 10-12 minutes."},{"step":"Allow to cool on cookie sheet for 5-10 minutes until set."},{"step":"Enjoy with a glass of milk!"}],"tags":[{"name":"Cookies"},{"name":"Desserts"},{"name":"Chocolate"}],"id":"d10bd211-68cf-4e2c-9f62-ccac11f93164"},{"title":"Test","servings":12,"description":"Test","totalTime":90,"ingredients":[{"name":"Test","quantity":1.0,"unit":"Cup"}],"instructions":[{"step":"Test 1"},{"step":"Test 2"}],"tags":[{"name":"Appetizers"},{"name":"Cookies"},{"name":"Desserts"}],"id":"814d0d0d-11e0-492a-8aea-f824b68dae15"},{"title":"Test","servings":12,"description":"Test\t","totalTime":90,"ingredients":[{"name":"Test","quantity":1.0,"unit":"None"}],"instructions":[{"step":"Test"}],"tags":[{"name":"Appetizers"},{"name":"Beef"}],"id":"6de52cc1-c47c-41ec-b3c4-666df54a9796"},{"title":"Chicken Soup","servings":8,"description":"Chicken Soup","totalTime":120,"ingredients":[{"name":"soup ingredients","quantity":1.0}],"instructions":[{"step":"heat well and eat"}],"tags":[{"name":"Soups"}],"id":"cd3aacea-c45e-4801-84fc-b47299494b15"},{"title":"Test 3 Edited","servings":12,"description":"Test 3","totalTime":180,"i